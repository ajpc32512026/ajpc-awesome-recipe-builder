  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Grease and line a 20 cm round cake tin with baking paper."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, whisk together oil, both sugars, eggs, and vanilla extract until smooth and well combined."
    },
    {
      "step": 3,
      "instruction": "Add mashed bananas and milk. Stir until evenly mixed."
    },
    {
      "step": 4,
      "instruction": "Sprinkle bi-carb soda and cinnamon over the wet mixture, then sift in the self-raising flour. Fold gently until just combined — do not overmix."
    },
    {
      "step": 5,
      "instruction": "Pour batter into the prepared tin and smooth the surface."
    },
    {
      "step": 6,
      "instruction": "Bake for 40–45 minutes, or until a skewer inserted into the centre comes out clean. Cool in the tin for 10 minutes, then turn out onto a wire rack to cool completely."
    },
    {
      "step": 7,
      "instruction": "For the frosting: beat softened butter until pale and creamy. Gradually add sifted icing sugar, beating until light and fluffy. Add lemon juice and beat until smooth."
    },
    {
      "step": 8,
      "instruction": "Spread frosting over the cooled cake. Sprinkle with toasted coconut, pressing gently to adhere."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Oil-Based Mixing",
      "content": "Oil keeps this cake exceptionally moist and tender. No creaming or mixer required — just a bowl, whisk, and spatula. The batter will be looser than a butter-based cake, which is correct."
    },
    {
      "type": "technique",
      "title": "Banana Ripeness",
      "content": "The bananas should be very ripe — heavily speckled or even black. The more ripe they are, the sweeter and more flavourful the cake will be."
    },
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Best eaten within 2 days. Store in an airtight container in a cool place. The toasted coconut adds a lovely crunch and nutty contrast to the soft cake."
    }
  ],
