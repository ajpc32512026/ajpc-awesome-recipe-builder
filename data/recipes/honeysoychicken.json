{
  "id": "honeysoychicken",
  "title": "Honey Soy Chicken",
  "category": "Dinner",
  "difficulty": "Beginner",
  "description": "Chicken thigh fillets marinated in honey, soy, garlic, and ginger. Pan-fried until sticky and caramelised. Serve with rice and vegetables.",
  "prepTime": "10 min",
  "cookTime": "15 min",
  "totalTime": "25 min + marinade time",
  "servings": "2",
  "yieldPerBatch": "2 serves",
  "tags": [
    "Chicken",
    "Dinner",
    "Easy",
    "Gluten-Free",
    "Make-Ahead",
    "Savoury",
    "Sweet"
  ],
  "ingredients": [
    {
      "quantity": "4",
      "unit": "",
      "item": "Chicken Thigh",
      "notes": "boneless"
    },
    {
      "quantity": "40",
      "unit": "ml",
      "item": "Honey"
    },
    {
      "quantity": "40",
      "unit": "ml",
      "item": "Soy Sauce",
      "notes": "regular all-purpose"
    },
    {
      "quantity": "3",
      "unit": "cloves",
      "item": "Garlic",
      "notes": "finely minced (about 1 tbsp)"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Fresh Ginger",
      "notes": "fresh, grated (about 2 tsp)"
    },
    {
      "quantity": "15",
      "unit": "ml",
      "item": "Vegetable Oil",
      "notes": "for marinade"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Peel and finely mince the garlic cloves. Peel and grate the fresh ginger."
    },
    {
      "step": 2,
      "instruction": "In a bowl, combine honey, soy sauce, minced garlic, grated ginger, and oil. Add chicken and mix well to coat."
    },
    {
      "step": 3,
      "instruction": "Cover and marinate in the refrigerator for at least 30 minutes, or up to 4 hours."
    },
    {
      "step": 4,
      "instruction": "Heat a large frying pan over medium-high heat. No extra oil needed — the marinade has enough."
    },
    {
      "step": 5,
      "instruction": "Remove chicken from marinade (reserve the marinade). Cook chicken for 4-5 minutes per side until golden, caramelised, and cooked through."
    },
    {
      "step": 6,
      "instruction": "Pour in reserved marinade and simmer for 1-2 minutes until the sauce thickens and coats the chicken."
    },
    {
      "step": 7,
      "instruction": "Serve hot with steamed rice and stir-fried vegetables. Garnish with sliced spring onion and sesame seeds if desired."
    }
  ],
  "notes": [
    {
      "type": "tip",
      "title": "Marinade Time",
      "content": "30 minutes minimum, 2-4 hours for deeper flavour. Do not marinate overnight — the soy sauce will make the chicken too salty."
    },
    {
      "type": "technique",
      "title": "Thicker Sauce",
      "content": "Mix 1 teaspoon cornflour with 2 teaspoons water and add to the sauce in the final minute for a thicker glaze."
    },
    {
      "type": "tip",
      "title": "Fresh vs Jar",
      "content": "Fresh garlic and ginger give a brighter, more aromatic flavour. Grate the ginger on a microplane for the finest texture."
    },
    {
      "type": "serving",
      "title": "Garnish",
      "content": "Garnish with sliced spring onion and sesame seeds before serving."
    }
  ],
