  "method": [
    {
      "step": 1,
      "instruction": "Combine orange juice, honey, soy sauce, vinegar, chilli garlic sauce, and orange zest in a small saucepan."
    },
    {
      "step": 2,
      "instruction": "Heat over medium heat, stirring, until the mixture begins to bubble."
    },
    {
      "step": 3,
      "instruction": "Reduce heat and simmer for 3–5 minutes until slightly thickened."
    },
    {
      "step": 4,
      "instruction": "Remove from heat and let cool slightly before serving. The sauce will thicken further as it cools."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Fantastic with crispy chicken or tofu. Drizzle over stir-fried vegetables or use as a glaze for grilled meats. The orange zest adds a fresh, bright note."
    },
    {
      "type": "variation",
      "title": "Heat Level",
      "content": "Adjust the chilli garlic sauce to taste. For milder heat, use half the amount. For extra fire, add a pinch of red chilli flakes."
    }
  ],
