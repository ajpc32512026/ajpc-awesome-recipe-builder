  "method": [
    {
      "step": 1,
      "instruction": "Heat olive oil in a saucepan over medium heat."
    },
    {
      "step": 2,
      "instruction": "Sauté onion for 3–4 minutes until translucent."
    },
    {
      "step": 3,
      "instruction": "Add garlic and cook for 1 minute until fragrant."
    },
    {
      "step": 4,
      "instruction": "Add crushed tomatoes, basil, and oregano. Stir well."
    },
    {
      "step": 5,
      "instruction": "Bring to a gentle simmer and cook for 20–25 minutes, stirring occasionally, until thickened."
    },
    {
      "step": 6,
      "instruction": "Season with salt and pepper to taste."
    }
  ],
