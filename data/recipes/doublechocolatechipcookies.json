      "item": "White Chocolate",
      "notes": "chips or chopped"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Line baking trays with baking paper."
    },
    {
      "step": 2,
      "instruction": "Cream butter and both sugars until smooth and fluffy. Add eggs one at a time, then stir in vanilla extract."
    },
    {
      "step": 3,
      "instruction": "Sift together flour, cocoa powder, bi-carb soda, and salt. Fold into the wet mixture until just combined."
    },
    {
      "step": 4,
      "instruction": "Fold in dark and white chocolate chips until evenly distributed."
    },
    {
      "step": 5,
      "instruction": "Drop spoonfuls of dough onto the prepared trays, leaving enough space for spreading."
    },
    {
      "step": 6,
      "instruction": "Bake for 10–12 minutes. Let cookies rest on the tray for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Soft Cookie Secret",
      "content": "Slightly underbaking gives the softest, fudgiest centre. The cookies will continue to set on the hot tray after coming out of the oven."
    },
    {
      "type": "storage",
      "title": "Storage",
      "content": "Keep in an airtight container for up to 5 days. Cookie dough can be frozen in balls and baked from frozen — add 2 minutes to the baking time."
    }
  ],
