  "method": [
    {
      "step": 1,
      "instruction": "Dry roast the dried chillies, coriander seeds, cumin seeds, fenugreek seeds, cardamom pods, cloves, cinnamon stick, and black peppercorns over low heat until aromatic, about 2 minutes."
    },
    {
      "step": 2,
      "instruction": "Remove from heat and allow spices to cool slightly."
    },
    {
      "step": 3,
      "instruction": "Transfer spices to a grinder and grind to a fine powder."
    },
    {
      "step": 4,
      "instruction": "Add ginger, garlic, and lemon juice. Process to a smooth paste, adding a little water if needed."
    }
  ],
  "notes": [
    {
      "type": "substitution",
      "title": "Lemon Juice Substitute",
      "content": "Lemon juice can be replaced with tamarind paste for a more traditional sour note."
    },
    {
      "type": "technique",
      "title": "Yield",
      "content": "This recipe makes approximately 80–100 g of vindaloo paste — enough for 1 kg of meat. Use the full batch for beef or lamb vindaloo."
    }
