  "method": [
    {
      "step": 1,
      "instruction": "In a large bowl, whisk together eggs, sugar, oil, milk, and flour until smooth and lump-free. The batter should be thin — the consistency of pouring cream."
    },
    {
      "step": 2,
      "instruction": "Heat a non-stick pan over medium heat. Lightly oil the surface, then wipe off excess with paper towel."
    },
    {
      "step": 3,
      "instruction": "Pour in a ladle of batter and swirl quickly to coat the pan thinly and evenly."
    },
    {
      "step": 4,
      "instruction": "Cook until the edges lift and the top looks dry, about 30 seconds, then flip and cook the second side for 15–30 seconds."
    },
    {
      "step": 5,
      "instruction": "Stack cooked crepes on a plate and cover with a clean tea towel to keep warm while you finish the batch."
    },
    {
      "step": 6,
      "instruction": "Serve warm with your choice of toppings — Nutella, sliced banana, strawberries, honey, golden syrup, cream, or maple syrup."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "The First Crepe",
      "content": "The first crepe is almost never perfect — it is the one that seasons the pan and helps you gauge the heat. Consider it a cook's snack and carry on."
    },
    {
      "type": "technique",
      "title": "Batter Consistency",
      "content": "The batter should be very thin, like pouring cream. If it is too thick, add a splash of milk. Letting the batter rest for 30 minutes improves the texture but is not essential."
    }
  ],
