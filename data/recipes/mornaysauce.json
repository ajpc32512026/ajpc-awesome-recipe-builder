  ],
  "ingredients": [
    {
      "quantity": "30",
      "unit": "g",
      "item": "Unsalted Butter"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Plain Flour"
    },
    {
      "quantity": "500",
      "unit": "ml",
      "item": "Milk Full-cream",
      "notes": "warmed"
    },
    {
      "quantity": "3",
      "unit": "g",
      "item": "Salt",
      "notes": "to taste"
    },
    {
      "quantity": "1",
      "unit": "g",
      "item": "Nutmeg",
      "notes": "ground"
    },
    {
      "quantity": "125",
      "unit": "g",
      "item": "Tasty Cheese",
      "notes": "grated, or cheddar"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Melt butter in a medium saucepan over medium heat."
    },
    {
      "step": 2,
      "instruction": "Add flour and whisk constantly for 1–2 minutes to cook out the raw flour taste. The roux should be smooth and pale golden, not browned."
    },
    {
      "step": 3,
      "instruction": "Gradually pour in the warmed milk, whisking constantly to prevent lumps from forming."
    },
    {
      "step": 4,
      "instruction": "Continue whisking over medium heat until the sauce thickens and comes to a gentle simmer, about 5–7 minutes."
    },
    {
      "step": 5,
      "instruction": "Once thickened to a coating consistency, reduce heat to low. Season with salt and nutmeg."
    },
    {
      "step": 6,
      "instruction": "Remove from heat and stir in the grated cheese. Mix until completely melted and smooth."
    },
    {
      "step": 7,
      "instruction": "Taste and adjust seasoning if needed. Use immediately while hot, or cover with plastic wrap pressed directly onto the surface to prevent a skin forming."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Smooth Sauce Secret",
      "content": "Warm milk prevents lumps and helps the sauce come together smoothly. Cold milk works too, but takes longer and requires more whisking."
    },
    {
      "type": "technique",
      "title": "Cheese Choice",
      "content": "Strong cheddar gives classic flavour. Gruyère adds sophistication. Parmesan brings umami. Mix cheeses for complexity. See the Cheese Sauce Tips page for more detail."
    },
    {
      "type": "technique",
      "title": "Thickness Control",
      "content": "For a thicker sauce, cook longer or add more cheese. For thinner, add more milk. The sauce will thicken slightly as it cools."
    }
  ],
