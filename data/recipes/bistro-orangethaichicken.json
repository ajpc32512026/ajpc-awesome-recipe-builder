  "ingredients": [
    {
      "quantity": "1",
      "unit": "",
      "item": "Chicken Breast",
      "notes": "pan-fried"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Fresh Ginger",
      "notes": "finely grated"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Red Chilli",
      "notes": "fresh, finely sliced"
    },
    {
      "quantity": "30",
      "unit": "ml",
      "item": "Orange Juice",
      "notes": "freshly squeezed"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Cream",
      "notes": "Thickened"
    },
    {
      "quantity": "5",
      "unit": "g",
      "item": "Orange Zest"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Unsalted Butter"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Brown Onion",
      "notes": "diced"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Melt half the butter in a frying pan over medium-high heat. Pan-fry chicken breast for 3–4 minutes per side until golden and cooked through. Remove and rest on a warm plate."
    },
    {
      "step": 2,
      "instruction": "In the same pan, add remaining butter. Add diced onion and grated ginger and cook until softened and fragrant, about 2–3 minutes."
    },
    {
      "step": 3,
      "instruction": "Add fresh chilli and cook briefly for 30 seconds until aromatic."
    },
    {
      "step": 4,
      "instruction": "Deglaze the pan with fresh orange juice. Let it reduce by half, about 1–2 minutes."
    },
    {
      "step": 5,
      "instruction": "Pour in thickened cream and reduce for 2–3 minutes until the sauce coats the back of a spoon. Season with salt."
    },
    {
      "step": 6,
      "instruction": "Stir in orange zest just before serving. Plate the chicken and spoon the citrus-cream sauce generously over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Orange Forward",
      "content": "The orange juice and zest lead this sauce — it should be distinctly citrus-forward with the cream providing body and richness rather than dominating. The ginger and chilli add warmth without overpowering the orange. No demi glace is used."
    }
  ],
