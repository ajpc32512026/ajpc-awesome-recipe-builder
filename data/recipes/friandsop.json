  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C fan-forced. Grease a 12-hole friand tin thoroughly."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, combine icing sugar, almond meal, flour, poppy seeds, and orange zest."
    },
    {
      "step": 3,
      "instruction": "In a separate bowl, whisk egg whites until just frothy — do not whip to stiff peaks."
    },
    {
      "step": 4,
      "instruction": "Add cooled melted butter, vanilla extract, and orange juice to the egg whites. Stir gently."
    },
    {
      "step": 5,
      "instruction": "Fold the dry ingredients into the wet mixture until just combined. Do not overmix."
    },
    {
      "step": 6,
      "instruction": "Pour batter into a 2-litre jug for easy pouring, then fill each friand tin about three-quarters full."
    },
    {
      "step": 7,
      "instruction": "Bake for 20–25 minutes until golden and domed."
    },
    {
      "step": 8,
      "instruction": "Cool in the tin for 5 minutes, then turn out onto a wire rack to cool completely."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Egg Whites",
      "content": "Only whisk the egg whites until frothy — just enough to break them up. Stiff peaks will make the friands tough and chewy rather than light and tender."
    },
    {
      "type": "technique",
      "title": "The Jug Method",
      "content": "Pouring the batter into a jug before filling the tins gives you perfect control and minimises mess. It is a small step that makes a big difference."
    }
  ],
