{
  "id": "roulade",
  "title": "Strawberry Meringue Roulade",
  "category": "Desserts",
  "difficulty": "Beginner",
  "description": "A light and airy meringue roulade filled with whipped cream and fresh strawberries.",
  "prepTime": "20 min",
  "cookTime": "15 min",
  "totalTime": "35 min",
  "servings": "6 servings",
  "yieldPerBatch": "6 servings",
