  ],
  "ingredients": [
    {
      "quantity": "250",
      "unit": "g",
      "item": "Peanut Butter",
      "notes": "crunchy or smooth"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Soy Sauce"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Curry Powder"
    },
    {
      "quantity": "250",
      "unit": "ml",
      "item": "Coconut Milk"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Water",
      "notes": "add gradually to thin as needed"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Combine peanut butter, soy sauce, curry powder, and coconut milk in a small saucepan."
    },
    {
      "step": 2,
      "instruction": "Warm gently over low heat, stirring patiently until smooth and well combined. Do not let it boil."
    },
    {
      "step": 3,
      "instruction": "Add water a splash at a time until the sauce reaches your desired consistency — thick enough to coat, thin enough to pour."
    },
    {
      "step": 4,
      "instruction": "Taste and adjust: add more curry powder for heat, a splash more soy sauce for depth, or a squeeze of lime for brightness."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Curry Powder",
      "content": "Add curry powder gradually and taste as you go — you can always add more, but too much will overpower the peanut flavour. Keen's curry powder works well here."
    },
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Serve warm over grilled chicken skewers, beef strips, lamb, or roasted vegetables. Also excellent as a dipping sauce for spring rolls or satay skewers."
    }
  ],
