{
  "id": "sataysauce",
  "title": "Satay Sauce",
  "category": "Sauces",
  "difficulty": "Beginner",
  "description": "Rich, creamy, slightly spicy, and perfect for chicken, beef, lamb, veggies — or eaten straight from the pan when no one's watching.",
  "prepTime": "5 min",
  "cookTime": "10 min",
  "totalTime": "15 min",
  "servings": "4 servings",
  "yieldPerBatch": "4 servings",
  "tags": [
