      "unit": "ml",
      "item": "Water"
    },
    {
      "quantity": "5",
      "unit": "ml",
      "item": "Sesame Oil"
    },
    {
      "quantity": "45",
      "unit": "ml",
      "item": "Vegetable Oil"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Brown Onion",
      "notes": "sliced"
    },
    {
      "quantity": "3",
      "unit": "",
      "item": "Spring Onion",
      "notes": "white and green parts separated, sliced"
    },
    {
      "quantity": "2",
      "unit": "cloves",
      "item": "Garlic",
      "notes": "crushed"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Combine beef strips with bi-carb soda, 5 g of the cornflour, 15 ml of the light soy sauce, and 15 ml of the Chinese rice wine. Mix well, cover, and set aside for 1 hour to marinate."
    },
    {
      "step": 2,
      "instruction": "Mix the remaining 5 g of cornflour with dark soy sauce and the remaining 5 ml of light soy sauce until smooth, then stir in sambal oelek, oyster sauce, the remaining 15 ml of Chinese rice wine, five spice, and water. Set sauce aside."
    },
    {
      "step": 3,
      "instruction": "Heat vegetable oil and sesame oil in a wok over high heat until smoking."
    },
    {
      "step": 4,
      "instruction": "Stir-fry onion and the white parts of spring onion for 1 minute. Add garlic and cook for 10 seconds until fragrant."
    },
    {
      "step": 5,
      "instruction": "Add marinated beef and stir-fry until no longer red, about 2 minutes."
    },
    {
      "step": 6,
      "instruction": "Pour in the sauce and cook until reduced and caramelised, about 3 minutes."
    },
    {
      "step": 7,
      "instruction": "Toss through the green parts of spring onion until just wilted. Serve immediately — ideally in a hot cast-iron pan for a sizzling effect."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Bi-Carb Soda Tenderising",
      "content": "The bi-carb soda in the marinade is a classic Chinese restaurant technique that tenderises the beef and gives it that signature silky texture. Do not skip it."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Inspiration",
      "content": "This Mongolian Beef Stir-Fry draws inspiration from traditional Chinese banquet cooking methods."
    }
  ],
