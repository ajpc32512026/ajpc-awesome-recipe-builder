      "notes": "divided: 15ml for Marinade, 5ml for Sauce"
    },
    {
      "quantity": "30",
      "unit": "ml",
      "item": "Chinese Rice Wine",
      "notes": "divided: 15ml for Marinade, 15ml for Sauce"
    },
    {
      "quantity": "10",
