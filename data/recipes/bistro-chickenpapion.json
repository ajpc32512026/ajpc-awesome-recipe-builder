  ],
  "ingredients": [
    {
      "quantity": "1",
      "unit": "",
      "item": "Chicken Breast",
      "notes": "pan-fried"
    },
    {
      "quantity": "6",
      "unit": "",
      "item": "Oysters",
      "notes": "fresh, shucked"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Thickened Cream"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Unsalted Butter"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Brown Onion",
      "notes": "diced"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "White Wine"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Melt half the butter in a frying pan over medium-high heat. Pan-fry chicken breast for 3–4 minutes per side until golden and cooked through. Remove and rest on a warm plate."
    },
    {
      "step": 2,
      "instruction": "In the same pan, add remaining butter. Add diced onion and cook until softened, about 2–3 minutes."
    },
    {
      "step": 3,
      "instruction": "Deglaze the pan with white wine. Let it bubble and reduce by half, about 1–2 minutes."
    },
    {
      "step": 4,
      "instruction": "Pour in thickened cream and stir. Reduce for 2–3 minutes until the sauce coats the back of a spoon. Season with salt."
    },
    {
      "step": 5,
      "instruction": "Add oysters to the sauce in the last 30–60 seconds — just enough to warm through. Do not overcook or they will become rubbery."
    },
    {
      "step": 6,
      "instruction": "Return chicken to the pan briefly to warm. Plate and spoon the sauce and oysters generously over the chicken."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Oyster Timing",
      "content": "The oysters go in at the very last moment — 30–60 seconds in the warm cream sauce only. Overcooking makes them rubbery and ruins the delicate texture that defines this dish. No demi glace is used."
    }
  ],
