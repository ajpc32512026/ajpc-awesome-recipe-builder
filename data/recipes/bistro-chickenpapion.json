{
  "id": "bistro-chickenpapion",
  "title": "Chicken Papion",
  "category": "Bistro",
  "difficulty": "Intermediate",
  "description": "Pan-fried chicken breast with fresh oysters folded into a cream sauce. Unusual, elegant, and utterly of its era.",
  "prepTime": "10 min",
  "cookTime": "8 min",
  "totalTime": "18 min",
  "servings": "1 serving",
  "yieldPerBatch": "1 serving",
