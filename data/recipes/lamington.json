  "ingredients": [
    {
      "quantity": "4",
      "unit": "",
      "item": "Eggs",
      "notes": "large"
    },
    {
      "quantity": "200",
      "unit": "g",
      "item": "White Sugar"
    },
    {
      "quantity": "5",
      "unit": "ml",
      "item": "Natural Vanilla Extract"
    },
    {
      "quantity": "75",
      "unit": "g",
      "item": "Plain Flour"
    },
    {
      "quantity": "3",
      "unit": "g",
      "item": "Baking Powder"
    },
    {
      "quantity": "125",
      "unit": "ml",
      "item": "Milk",
      "notes": "Full-cream"
    },
    {
      "quantity": "75",
      "unit": "g",
      "item": "Unsalted Butter",
      "notes": "divided: 60g for Sponge, 15g for Icing"
    },
    {
      "heading": "Chocolate Glace"
    },
    {
      "quantity": "375",
      "unit": "g",
      "item": "Icing Sugar"
    },
    {
      "quantity": "35",
      "unit": "g",
      "item": "Cocoa Powder"
    },
    {
      "quantity": "180",
      "unit": "ml",
      "item": "Water"
    },
    {
      "heading": "Decoration"
    },
    {
      "quantity": "200",
      "unit": "g",
      "item": "Desiccated Coconut"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Line a 20 cm × 30 cm slab pan with baking paper."
    },
    {
      "step": 2,
      "instruction": "In the bowl of a stand mixer, beat eggs and sugar on high speed for 6–8 minutes until pale, thick, and tripled in volume."
    },
    {
      "step": 3,
      "instruction": "Stir in vanilla extract."
    },
    {
      "step": 4,
      "instruction": "Sift flour and baking powder together, then gently fold into the egg mixture in three batches, keeping as much air in the batter as possible."
    },
    {
      "step": 5,
      "instruction": "Heat milk and 60 g of the unsalted butter together until melted and warm. Mix a scoop of the batter into the milk mixture, then fold back into the main bowl until just combined."
    },
    {
      "step": 6,
      "instruction": "Pour into the prepared pan and bake for 22–25 minutes or until a skewer inserted into the centre comes out clean."
    },
    {
      "step": 7,
      "instruction": "Cool completely on a wire rack. For easier cutting, chill or freeze the sponge briefly."
    },
    {
      "step": 8,
      "instruction": "For the icing: sift icing sugar and cocoa powder into a bowl. Add 180 ml boiling water and the remaining 15 g of unsalted butter. Whisk until smooth. Keep warm while using."
    },
    {
      "step": 9,
      "instruction": "Cut the sponge into 4–5 cm squares."
    },
    {
      "step": 10,
      "instruction": "Dip each square into the warm chocolate icing, letting the excess drip off."
    },
    {
      "step": 11,
      "instruction": "Roll each coated square in desiccated coconut until fully coated."
    },
    {
      "step": 12,
      "instruction": "Set on a wire rack to firm up before serving."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Sponge Tips",
      "content": "Beat the eggs and sugar until they are genuinely thick and pale — this is what creates the light sponge structure. Fold the flour in gently to keep the air in the batter."
    },
    {
      "type": "variation",
      "title": "Deluxe Version",
      "content": "Split each square and fill with raspberry jam and whipped cream for the full bakery-style experience."
    }
  ],
