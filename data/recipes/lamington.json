{
  "id": "lamington",
  "title": "Classic Lamingtons",
  "category": "Snacks",
  "difficulty": "Intermediate",
  "description": "Aussie pride in a cake cube — built properly, with a real sponge that can hold its own.",
  "prepTime": "30 min",
  "cookTime": "25 min",
  "totalTime": "55 min",
  "servings": "16 squares",
  "yieldPerBatch": "16 squares",
  "tags": [
