  "method": [
    {
      "step": 1,
      "instruction": "Heat olive oil in a large frying pan over medium-high heat. Add chicken in batches and cook, stirring, for 5 minutes until browned. Transfer to a bowl."
    },
    {
      "step": 2,
      "instruction": "Add bacon to the pan and cook, stirring, until golden. Add spring onion, garlic, and mushrooms. Cook until mushrooms are tender."
    },
    {
      "step": 3,
      "instruction": "Return chicken to the pan. Add flour and cook, stirring, for 1 minute."
    },
    {
      "step": 4,
      "instruction": "Add chicken stock, salt, and pepper. Reduce heat to low. Cover and simmer for 15 minutes or until sauce thickens."
    },
    {
      "step": 5,
      "instruction": "Remove from heat and stir in mascarpone until melted and smooth. Allow to cool completely."
    },
    {
      "step": 6,
      "instruction": "Preheat oven to 200°C (180°C fan-forced). Grease 4 pie tins, approximately 7.5 cm base x 11 cm top."
    },
    {
      "step": 7,
      "instruction": "Cut each shortcrust pastry sheet in half diagonally to form 4 large triangles. Line the base and sides of each tin with one triangle, pressing in gently. Trim edges and brush with beaten egg."
    },
    {
      "step": 8,
      "instruction": "Spoon the cooled chicken filling evenly into the pastry cases."
    },
    {
      "step": 9,
      "instruction": "Cut puff pastry into 4 squares. Place one square over each pie filling, trim edges, and press to seal."
    },
    {
      "step": 10,
      "instruction": "Place tins on a baking tray. Brush tops with beaten egg and sprinkle with sesame seeds."
    },
    {
      "step": 11,
      "instruction": "Bake for 30 minutes or until golden and puffed."
    },
    {
      "step": 12,
      "instruction": "Allow pies to rest for 5 minutes before serving."
    }
  ],
  "notes": [
    {
      "type": "storage",
      "title": "Make-Ahead",
      "content": "These pies can be assembled unbaked and frozen for up to 2 months. Bake from frozen, adding 10–15 minutes to the cooking time."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Origin",
