  "ingredients": [
    {
      "quantity": "125",
      "unit": "ml",
      "item": "Water"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "White Vinegar"
    },
    {
      "quantity": "65",
      "unit": "g",
      "item": "White Sugar"
    },
    {
