      "notes": "crushed"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Cornflour"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "In a small saucepan, combine water, vinegar, sugar, chilli garlic sauce, and minced garlic."
    },
    {
      "step": 2,
      "instruction": "Bring to a gentle simmer over medium heat, stirring until the sugar dissolves completely."
    },
    {
      "step": 3,
      "instruction": "In a small bowl, mix cornflour with 1 tablespoon of cold water to form a smooth slurry. Add to the saucepan."
    },
    {
      "step": 4,
      "instruction": "Continue stirring until the sauce thickens, about 2–3 minutes."
    },
    {
      "step": 5,
      "instruction": "Remove from heat and allow to cool. Transfer to a clean jar and store in the refrigerator for up to 2 weeks."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Excellent with spring rolls, fried chicken, or as a marinade. Can also be used as a dipping sauce for dumplings or drizzled over grilled meats."
    }
  ],
