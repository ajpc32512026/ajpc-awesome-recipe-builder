      "notes": "fresh, don't use frozen"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Chives",
      "notes": "chopped, for garnish"
    },
    {
      "quantity": "200",
      "unit": "g",
      "item": "Egg Noodles",
      "notes": "to serve; or substitute wholegrain toast"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Toss beef strips with paprika, salt, and black pepper in a bowl."
    },
    {
      "step": 2,
      "instruction": "Heat olive oil in a large frying pan over medium-high heat. Add beef in batches and cook for 2–3 minutes until browned. Remove and set aside."
    },
    {
      "step": 3,
      "instruction": "Reduce heat to medium. In the same pan, add the sliced onion and cook for 2–3 minutes until softened."
    },
    {
      "step": 4,
      "instruction": "Add mushrooms and cook for 3–4 minutes until golden and tender."
    },
    {
      "step": 5,
      "instruction": "Add beef stock and Worcestershire sauce. Bring to a simmer and cook for 3–4 minutes to reduce slightly."
    },
    {
      "step": 6,
      "instruction": "Return beef and any collected juices to the pan. Stir through."
    },
    {
      "step": 7,
      "instruction": "Reduce heat to low. Stir in sour cream gently and heat through without boiling — boiling will split the sauce."
    },
    {
      "step": 8,
      "instruction": "Meanwhile, steam green beans until just tender, about 3–4 minutes."
    },
    {
      "step": 9,
      "instruction": "Serve stroganoff over egg noodles or wholegrain toast, garnished with fresh chives and green beans on the side."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Temperature Control",
      "content": "Keep the heat gentle once the sour cream goes in. Boil it and the sauce will split — there is no fixing that."
    },
    {
      "type": "variation",
      "title": "Red Wine Addition",
      "content": "Using dry red wine is optional — it adds richness but is not required for a classic stroganoff flavour. Add 60 ml with the stock if desired."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Origin",
      "content": "This Beef & Mushroom Stroganoff is adapted from a recipe originally published by Taste.com.au."
    }
  ],
