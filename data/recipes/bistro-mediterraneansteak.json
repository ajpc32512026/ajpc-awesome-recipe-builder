  ],
  "ingredients": [
    {
      "quantity": "180",
      "unit": "g",
      "item": "Beef",
      "notes": "Scotch Fillet"
    },
    {
      "quantity": "150",
      "unit": "g",
      "item": "Prawns",
      "notes": "king, peeled and deveined"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Green Peppercorns",
      "notes": "brined"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Cream",
      "notes": "Thickened"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Demi Glace"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Butter"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Brown Onion",
      "notes": "diced"
    },
    {
      "quantity": "30",
      "unit": "ml",
      "item": "Brandy"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Grill or pan-fry scotch fillets over high heat to desired doneness. Remove and rest on a warm plate."
    },
    {
      "step": 2,
      "instruction": "Melt butter in the same pan over medium heat. Add diced onion and cook until softened, about 2–3 minutes."
    },
    {
      "step": 3,
      "instruction": "Add prawns and cook for 1–2 minutes until just pink — they will finish in the sauce."
    },
    {
      "step": 4,
      "instruction": "Deglaze the pan with brandy. Let it reduce by half, about 1 minute."
    },
    {
      "step": 5,
      "instruction": "Add demi glace and thickened cream. Stir and reduce for 2–3 minutes until the sauce is rich and coats the back of a spoon."
    },
    {
      "step": 6,
      "instruction": "Add green peppercorns and stir through. Season with salt."
    },
    {
      "step": 7,
      "instruction": "Plate the steak, arrange prawns around and over, and spoon the sauce generously over everything."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Prawn Timing",
      "content": "Prawns finish cooking in the sauce — do not overcook them in the initial sear or they will become tough. Brandy is the correct alcohol for the deglaze, giving a warmer, richer note than white wine."
    }
  ],
