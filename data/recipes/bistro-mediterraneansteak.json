{
  "id": "bistro-mediterraneansteak",
  "title": "Mediterranean Steak",
  "category": "Bistro",
  "difficulty": "Intermediate",
  "description": "Scotch fillet in a rich cream sauce with king prawns and green peppercorns. Surf and turf done properly — the bistro way.",
  "prepTime": "5 min",
  "cookTime": "8 min",
  "totalTime": "13 min",
  "servings": "1 serving",
  "yieldPerBatch": "1 serving",
  "tags": [
