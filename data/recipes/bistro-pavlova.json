      "notes": "halved"
    },
    {
      "quantity": "2",
      "unit": "",
      "item": "Kiwi Fruit",
      "notes": "sliced"
    },
    {
      "quantity": "2",
      "unit": "",
      "item": "Passionfruit",
      "notes": "pulp only"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Mango",
      "notes": "sliced"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 120°C. Draw a 22 cm circle on a sheet of baking paper and place on a baking tray, pencil side down."
    },
    {
      "step": 2,
      "instruction": "In a clean, grease-free bowl, whip egg whites to stiff peaks using an electric mixer."
    },
    {
      "step": 3,
      "instruction": "Gradually add caster sugar, a spoonful at a time, beating continuously until the mixture is very thick, glossy, and the sugar has completely dissolved — rub a little between your fingers to check."
    },
    {
      "step": 4,
      "instruction": "Gently fold in vinegar, cornflour, and vanilla extract until just combined."
    },
    {
      "step": 5,
      "instruction": "Mound the meringue onto the circle, shaping it into a nest with a slight dip in the centre and soft peaks around the edges."
    },
    {
      "step": 6,
      "instruction": "Bake for 90 minutes. Turn the oven off and leave the pavlova inside with the door closed to cool completely — ideally overnight."
    },
    {
      "step": 7,
      "instruction": "Just before serving, top with whipped cream and arrange fresh strawberries, kiwi, passionfruit pulp, and mango slices over the cream."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Sugar Dissolving",
      "content": "The key to a successful pavlova is ensuring the sugar is fully dissolved before baking. Rub a little meringue between your fingers — if it feels grainy, keep beating. Undissolved sugar causes weeping beads on the surface during baking."
    },
    {
      "type": "technique",
      "title": "Cooling",
      "content": "Leave the pavlova in the turned-off oven with the door closed until completely cool. Rapid temperature change causes cracking and collapse. Overnight cooling gives the best result."
    }
  ],
