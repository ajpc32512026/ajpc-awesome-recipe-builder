  "method": [
    {
      "step": 1,
      "instruction": "Heat half the vegetable oil in a large frying pan over medium-high heat. Add chicken cubes and cook for 5–6 minutes until golden brown and cooked through. Remove and set aside."
    },
    {
      "step": 2,
      "instruction": "In the same pan, heat the remaining oil and butter over medium heat. Add onion and sauté for 3–4 minutes until soft and translucent."
    },
    {
      "step": 3,
      "instruction": "Add ginger, garlic, and bay leaves. Cook for 1 minute until fragrant."
    },
    {
      "step": 4,
      "instruction": "Stir in cumin, garam masala, and red chilli powder. Cook for 30 seconds to release the aromas."
    },
    {
      "step": 5,
      "instruction": "Add tomato paste and cook for 1–2 minutes, stirring constantly, until it darkens slightly."
    },
    {
      "step": 6,
      "instruction": "Pour in the cream, yoghurt, and milk. Stir well and bring to a gentle simmer. Cook for 3–4 minutes until the sauce thickens slightly."
    },
    {
      "step": 7,
      "instruction": "Add the cooked chicken and any collected juices back into the sauce. Stir through."
    },
    {
      "step": 8,
      "instruction": "Add ground fenugreek and ground cashews. Stir well and simmer for another 3–4 minutes."
    },
    {
      "step": 9,
      "instruction": "Stir in the lemon juice and taste. Adjust seasoning with salt if needed."
    },
    {
      "step": 10,
      "instruction": "Remove from heat. Garnish with fresh coriander and serve hot with naan bread or basmati rice."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Chicken Choice",
      "content": "Chicken thighs work best for this recipe as they stay tender and juicy. Breast meat can dry out if overcooked."
    },
    {
      "type": "variation",
      "title": "Extra Richness",
      "content": "For an even richer sauce, add an extra tablespoon of butter at the end and swirl through just before serving."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Origin",
      "content": "This recipe is adapted from traditional Indian butter chicken recipes with home-cook friendly adjustments."
    }
