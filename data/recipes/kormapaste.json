  "method": [
    {
      "step": 1,
      "instruction": "Place cumin seeds and coriander seeds in a small frying pan over low heat. Roast, stirring constantly, for 2 minutes or until slightly browned and fragrant. Remove from heat and let cool."
    },
    {
      "step": 2,
      "instruction": "Transfer roasted seeds to a food processor. Add turmeric, garam masala, red chilli powder, garlic, ginger, tomato paste, desiccated coconut, cashews, vegetable oil, and fresh coriander leaves."
    },
    {
      "step": 3,
      "instruction": "Grind to a smooth paste, scraping down the sides as needed. Add a small splash of water if the paste is too thick."
    },
    {
      "step": 4,
      "instruction": "Store in an airtight container in the refrigerator for up to 3 days, or freeze for up to 3 months."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Dry Roasting",
      "content": "Roasting the cumin and coriander seeds before grinding releases their essential oils and deepens the flavour. Do not skip this step — it is the difference between a good korma and a great one."
    },
    {
      "type": "technique",
      "title": "Yield",
      "content": "This recipe makes approximately 120–150 g of korma paste — enough for 1 kg of meat or vegetables. Use the full batch for lamb or chicken korma."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Source",
      "content": "Adapted from traditional Indian korma recipes."
    }
  ],
