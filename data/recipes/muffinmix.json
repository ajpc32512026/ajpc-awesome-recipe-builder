  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Grease a 12-cup muffin tin or line with paper liners."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, mix the self-raising flour, plain flour, sugar, and salt. Add your chosen additions and stir to combine."
    },
    {
      "step": 3,
      "instruction": "In a separate bowl, whisk together the oil, egg, and milk until well combined. Add vanilla extract if making sweet muffins."
    },
    {
      "step": 4,
      "instruction": "Pour the wet ingredients into the dry ingredients. Mix gently with a spatula until just combined — the batter should be slightly lumpy. Do not overmix or the muffins will be tough."
    },
    {
      "step": 5,
      "instruction": "Divide the mixture evenly between the muffin cups, filling each about three-quarters full."
    },
    {
      "step": 6,
      "instruction": "Bake for 18–22 minutes, or until a skewer inserted into the centre comes out clean and the tops are golden and spring back when lightly touched."
    },
    {
      "step": 7,
      "instruction": "Cool in the tin for 5 minutes, then transfer to a wire rack. Serve warm or at room temperature."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Don't Overmix",
      "content": "The secret to tender muffins is gentle mixing. Lumpy batter is perfect — overmixing develops gluten and makes muffins tough and dense."
    },
    {
      "type": "technique",
      "title": "Chocolate Chip Trick",
      "content": "Toss chocolate chips in a little plain flour before adding to the batter. This prevents them from sinking to the bottom during baking."
    },
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Microwave for 10–20 seconds before serving for that fresh-from-the-oven warmth."
    },
    {
      "type": "storage",
      "title": "Storage",
      "content": "Store in an airtight container for 2–3 days, or freeze for up to 2 months."
    }
  ],
