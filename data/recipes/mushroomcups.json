{
  "id": "mushroomcups",
  "title": "Mushrooms with Herb Nut Butter",
  "category": "Entree",
  "difficulty": "Beginner",
  "description": "Baked mushroom caps filled with a rich herb and almond butter, finished until golden and fragrant.",
  "prepTime": "10 min",
  "cookTime": "15 min",
  "totalTime": "25 min",
  "servings": "4 servings",
  "yieldPerBatch": "4 servings",
  "tags": [
    "Gluten-Free",
    "Rich",
    "Savoury",
    "Vegetarian"
  ],
  "ingredients": [
    {
      "quantity": "12",
      "unit": "",
      "item": "Mushrooms",
      "notes": "large, stalks removed and chopped"
    },
    {
      "quantity": "15",
      "unit": "ml",
      "item": "Olive Oil"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Brown Onion",
      "notes": "small, finely chopped"
    },
    {
      "quantity": "40",
      "unit": "g",
      "item": "Almonds",
      "notes": "blanched"
    },
    {
      "quantity": "1",
      "unit": "clove",
      "item": "Garlic"
    },
    {
      "quantity": "15",
      "unit": "ml",
      "item": "Lemon Juice"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Fresh Parsley",
      "notes": "fresh, chopped"
    },
    {
      "quantity": "5",
      "unit": "g",
      "item": "Fresh Thyme",
      "notes": "fresh"
    },
    {
      "quantity": "2",
      "unit": "sprigs",
      "item": "Fresh Rosemary"
    },
    {
      "quantity": "5",
      "unit": "g",
      "item": "Chives",
      "notes": "chopped"
    },
    {
      "quantity": "75",
      "unit": "g",
      "item": "Butter",
      "notes": "softened"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once, You can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Brush a shallow baking dish with oil or melted butter."
    },
    {
      "step": 2,
      "instruction": "Remove mushroom stalks and chop them finely. Set caps aside."
    },
    {
      "step": 3,
      "instruction": "Heat olive oil in a small pan over medium heat. Add onion and cook for 2–3 minutes until soft and golden."
    },
    {
      "step": 4,
      "instruction": "Add chopped mushroom stalks and cook for a further 2 minutes until softened. Remove from heat."
    },
    {
      "step": 5,
      "instruction": "Place almonds, garlic, lemon juice, parsley, thyme, rosemary, chives, salt, pepper, and butter into a food processor. Process until smooth and well combined."
    },
    {
      "step": 6,
      "instruction": "Arrange mushroom caps in the prepared baking dish."
    },
    {
      "step": 7,
      "instruction": "Spoon the onion and mushroom stalk mixture evenly into each cap."
    },
    {
      "step": 8,
      "instruction": "Top each mushroom with the herb nut butter."
    },
    {
      "step": 9,
      "instruction": "Bake for 10–15 minutes or until mushrooms are tender and butter has melted."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Make-Ahead",
      "content": "Mushroom caps may be assembled up to 2 hours ahead and refrigerated on a flat tray. Bake just before serving."
    },
    {
      "type": "acknowledgement",
