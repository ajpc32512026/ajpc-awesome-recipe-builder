  "method": [
    {
      "step": 1,
      "instruction": "In a small bowl, mix cornflour with dark soy sauce and light soy sauce until smooth."
    },
    {
      "step": 2,
      "instruction": "Add sambal oelek, hoisin sauce, Chinese rice wine, five spice, water, and sesame oil. Stir well to combine."
    },
    {
      "step": 3,
      "instruction": "Pour into a small saucepan or wok and heat gently, stirring, until the sauce thickens, about 2–3 minutes."
    },
    {
      "step": 4,
      "instruction": "Use immediately over cooked meat or vegetables, or cool and store in an airtight container in the refrigerator for up to 1 week."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Make-Ahead",
      "content": "This sauce can be made in advance and stored in the refrigerator. Reheat gently before using — it will thicken when cold."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Inspiration",
      "content": "Adapted from traditional Chinese stir-fry sauces, balancing heat, sweetness, and umami."
    }
