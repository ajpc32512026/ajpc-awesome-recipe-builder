  "method": [
    {
      "step": 1,
      "instruction": "Heat 30 ml of olive oil in a large deep pan or Dutch oven over medium-high heat."
    },
    {
      "step": 2,
      "instruction": "Season chicken breasts with salt and pepper. Brown chicken on both sides, about 3–4 minutes per side, until golden. Remove and set aside."
    },
    {
      "step": 3,
      "instruction": "In the same pan, add remaining 15 ml of oil. Add chopped onion and sauté for 2–3 minutes until softened."
    },
    {
      "step": 4,
      "instruction": "Add garlic and cook for 1 minute until fragrant."
    },
    {
      "step": 5,
      "instruction": "Pour in the white wine and vinegar. Bring to a simmer and cook for 2–3 minutes to reduce slightly."
    },
    {
      "step": 6,
      "instruction": "Crumble in the stock cubes and add hot water. Stir to dissolve."
    },
    {
      "step": 7,
      "instruction": "Add the tomatoes, crushing them with your hands or a spoon, along with basil and sugar. Stir well."
    },
    {
      "step": 8,
      "instruction": "Return the browned chicken to the pan. Bring to a gentle simmer, then reduce heat to low. Cover and cook for 25–30 minutes until chicken is cooked through and tender."
    },
    {
      "step": 9,
      "instruction": "Add Kalamata olives and milk. Stir gently and simmer uncovered for another 5–7 minutes to let the sauce thicken slightly."
    },
    {
      "step": 10,
      "instruction": "Taste and adjust seasoning with salt and pepper. Stir in chopped parsley just before serving."
    },
    {
      "step": 11,
      "instruction": "Serve hot over jasmine rice, pasta, or with crusty bread to soak up the sauce."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Wine and Vinegar Balance",
      "content": "Adjust wine and vinegar to taste for tanginess. Start with less and add more if you prefer a sharper flavour."
    },
    {
      "type": "variation",
      "title": "Chicken Thighs",
      "content": "Chicken thighs can be used instead of breasts for extra juiciness and flavour. Bone-in thighs will need 10–15 minutes longer cooking time."
    },
    {
      "type": "serving",
      "title": "Reheating",
      "content": "This dish tastes even better the next day as the flavours develop. Reheat gently on the stovetop."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Origin",
      "content": "Adapted from traditional Italian cacciatore recipes — a classic hunter-style braise."
    }
  ],
