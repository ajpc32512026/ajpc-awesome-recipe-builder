{
  "id": "beefvindaloo",
  "title": "Beef Vindaloo",
  "category": "Dinner",
  "difficulty": "Intermediate",
  "description": "An authentic, fiery, melt-in-your-mouth beef curry that doesn't muck around.",
  "prepTime": "15 min",
