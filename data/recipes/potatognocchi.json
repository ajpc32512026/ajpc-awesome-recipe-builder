{
  "id": "potatognocchi",
  "title": "Potato Gnocchi with Tomato Sauce",
  "category": "Dinner",
  "difficulty": "Intermediate",
  "description": "Soft potato gnocchi served with a simple tomato and basil sauce.",
  "prepTime": "30 min",
  "cookTime": "35 min",
  "totalTime": "1 hr 5 min",
  "servings": "4 servings",
  "yieldPerBatch": "4 servings",
