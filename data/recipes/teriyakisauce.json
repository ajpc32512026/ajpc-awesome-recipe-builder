  "method": [
    {
      "step": 1,
      "instruction": "Combine soy sauce, water, sugar, honey, mirin, and garlic in a small saucepan."
    },
    {
      "step": 2,
      "instruction": "Heat over medium, stirring until the sugar dissolves completely."
    },
    {
      "step": 3,
      "instruction": "Bring to a gentle simmer and cook for 3–4 minutes until slightly thickened."
    },
    {
      "step": 4,
      "instruction": "Remove from heat and allow to cool before using. The sauce will continue to thicken as it cools."
    }
  ],
