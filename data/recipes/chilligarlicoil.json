{
  "id": "chilligarlicoil",
  "title": "Chilli Garlic Oil",
  "category": "Sauces",
  "difficulty": "Beginner",
  "description": "A fragrant Asian condiment — fiery, aromatic, and incredibly versatile. Elevates everything it touches.",
  "prepTime": "5 min",
  "cookTime": "10 min",
  "totalTime": "15 min",
  "servings": "8 servings",
  "yieldPerBatch": "8 servings",
  "tags": [
    "Gluten-Free",
    "Make-Ahead",
    "Sauce",
    "Spicy",
    "Vegan",
    "Vegetarian"
  ],
  "ingredients": [
    {
      "quantity": "250",
      "unit": "ml",
      "item": "Vegetable Oil",
      "notes": "Or light olive oil"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Red Chilli Flakes"
    },
    {
      "quantity": "1",
      "unit": "bulb",
      "item": "Garlic",
      "notes": "minced"
    },
    {
      "quantity": "15",
      "unit": "ml",
      "item": "Soy Sauce"
    },
    {
      "quantity": "5",
      "unit": "g",
      "item": "White Sugar"
    },
    {
      "item": "Salt",
      "toTaste": true,
      "notes": "Don't add too much all at once, you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Heat vegetable oil in a small saucepan over low heat."
    },
    {
      "step": 2,
      "instruction": "Add minced garlic and cook gently until lightly golden, about 3–4 minutes. Do not let it brown or it will turn bitter."
    },
    {
      "step": 3,
      "instruction": "Add chilli flakes, salt, soy sauce, and sugar. Stir for 1–2 minutes until fragrant."
    },
    {
      "step": 4,
      "instruction": "Remove from heat and allow to cool completely."
    },
    {
      "step": 5,
      "instruction": "Transfer to a clean jar. Store in the refrigerator for up to 1 month."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Drizzle over noodles, dumplings, or rice. Spoon over eggs, stir-fries, or grilled meats for an instant flavour boost."
    },
    {
      "type": "technique",
      "title": "Garlic Care",
      "content": "Keep the heat low when cooking garlic. If it burns, start again — burnt garlic makes the oil bitter and unusable."
    }
  ],
