  "method": [
    {
      "step": 1,
      "instruction": "In a large bowl, whisk together vegetable oil, lemon juice, garlic, salt, paprika, cumin, cardamom, red chilli flakes, and cinnamon."
    },
    {
      "step": 2,
      "instruction": "Add chicken strips to the marinade and stir to coat evenly. Cover and refrigerate for at least 1 hour or up to 24 hours."
    },
    {
      "step": 3,
      "instruction": "Heat a large frying pan or wok over high heat until very hot."
    },
    {
      "step": 4,
      "instruction": "Add the marinated chicken strips in a single layer. Cook for 2–3 minutes without moving to get a good sear, then stir-fry for another 3–4 minutes until cooked through and slightly charred at the edges."
    },
    {
      "step": 5,
      "instruction": "Remove from heat and serve immediately over rice or in pita with pickles, tomatoes, lettuce, and garlic or tahini sauce."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Marinating Time",
      "content": "Minimum 1 hour marinating is required. For best results, marinate overnight — the lemon and spices will tenderise the chicken deeply."
    },
    {
      "type": "technique",
      "title": "Hot Pan",
      "content": "The pan must be very hot before adding the chicken. A quick, hard sear gives the charred edges that define shawarma. Avoid overcrowding — cook in batches if needed."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Inspiration",
      "content": "Inspired by traditional Middle Eastern shawarma techniques."
    }
  ],
