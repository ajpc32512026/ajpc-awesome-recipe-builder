{
  "id": "chocolatemugcake",
  "title": "Eggless Chocolate Mug Muffin",
  "category": "Snacks",
  "difficulty": "Beginner",
  "description": "A single-serve chocolate cake made in a mug without eggs. Richer and more brownie-like in texture, ready in about a minute.",
  "prepTime": "2 min",
  "cookTime": "1 min",
  "totalTime": "3 min",
  "servings": "1",
  "yieldPerBatch": "1 large mug cake",
  "tags": [
    "Baking",
    "Chocolate",
    "Dessert",
    "Easy",
    "Microwave",
    "Single Serve",
    "Sweet",
    "Vegetarian",
    "Egg-free"
  ],
  "ingredients": [
    {
      "quantity": "50",
      "unit": "g",
      "item": "Plain Flour"
    },
    {
      "quantity": "40",
      "unit": "g",
      "item": "Caster Sugar"
    },
    {
      "quantity": "15",
      "unit": "g",
      "item": "Cocoa Powder"
    },
    {
      "quantity": "2",
      "unit": "g",
      "item": "Baking Powder"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Milk",
      "notes": "Full-cream"
    },
    {
      "quantity": "30",
      "unit": "ml",
      "item": "Vegetable Oil"
    },
    {
      "quantity": "2",
      "unit": "ml",
      "item": "Natural Vanilla Extract"
    },
    {
      "quantity": "20",
      "unit": "g",
      "item": "Chocolate Chips",
      "notes": "optional"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "In a microwave-safe mug (350-400ml capacity), whisk together flour, sugar, cocoa powder, and baking powder."
    },
    {
      "step": 2,
      "instruction": "Add milk, vegetable oil, and vanilla extract. Stir with a fork until smooth and fully combined."
    },
    {
      "step": 3,
      "instruction": "Fold in chocolate chips if using."
    },
    {
      "step": 4,
      "instruction": "Microwave on high. For a 1350W microwave, start with 50-60 seconds. The cake should be risen and the top mostly set."
    },
    {
      "step": 5,
      "instruction": "Let stand in the mug for 1 minute before eating to allow carryover cooking to finish the center."
    }
  ],
  "notes": [
    {
      "type": "tip",
      "title": "Microwave Power",
      "content": "Since this version has no egg, it is safe to eat slightly 'underdone'. High-wattage microwaves (1350W) cook significantly faster; avoid going over 60 seconds initially."
    },
    {
      "type": "technique",
      "title": "Big Mug Needed",
      "content": "Use a mug that holds at least 350ml. The cake rises significantly during cooking."
    },
    {
      "type": "variation",
      "title": "Dairy-free",
      "content": "Substitute full-cream milk with oat or almond milk."
    }
  ],
