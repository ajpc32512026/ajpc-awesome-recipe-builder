  "method": [
    {
      "step": 1,
      "instruction": "Soak bihon noodles in warm water for 10 minutes until softened, then drain and set aside. Do not oversoak — they will finish cooking in the broth."
    },
    {
      "step": 2,
      "instruction": "Heat oil in a large wok over medium-high heat. Sauté garlic and onion until fragrant, then add pork and chicken. Cook until browned."
    },
    {
      "step": 3,
      "instruction": "Add carrot, celery, and snow peas. Stir-fry for a few minutes until just tender, then remove the meat and vegetables from the wok and set aside to keep them crisp."
    },
    {
      "step": 4,
      "instruction": "Pour chicken stock, soy sauce, and fish sauce into the wok. Bring to a boil. Add the drained noodles and toss continuously until they absorb most of the liquid."
    },
    {
      "step": 5,
      "instruction": "Return the cooked meat and vegetables to the wok. Add shredded cabbage last and toss everything together until well combined and heated through."
    },
    {
      "step": 6,
      "instruction": "Season with ground black pepper to taste. Transfer to a serving dish, top with chopped spring onion, and serve with calamansi or lemon wedges on the side."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Keep Vegetables Crisp",
      "content": "Removing the vegetables from the wok before simmering the noodles prevents them from overcooking and going soggy."
    },
    {
      "type": "technique",
      "title": "Noodle Soaking",
      "content": "Do not oversoak the bihon — 10 minutes in warm water is enough. They will finish cooking in the broth. Avoid cutting the noodles before serving as pancit symbolises long life."
    },
    {
      "type": "variation",
      "title": "Meat Options",
      "content": "You can use all pork, all chicken, or add small shrimp for variety. Leftover rotisserie chicken works well here."
    }
  ],
