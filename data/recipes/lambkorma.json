      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once, You can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Heat vegetable oil in a heavy-bottomed pan over medium heat. Add diced onion and fry until softened and translucent."
    },
    {
      "step": 2,
      "instruction": "Add ginger paste and garlic paste. Fry for a few seconds until fragrant."
    },
    {
      "step": 3,
      "instruction": "Add bay leaves, cinnamon stick, and dried red chilli. Stir briefly."
    },
    {
      "step": 4,
      "instruction": "Add ground cumin, nutmeg, garam masala, and red chilli powder. Fry for 30 seconds to release the aromas."
    },
    {
      "step": 5,
      "instruction": "Add lamb pieces. Fry, stirring occasionally, for 3–4 minutes until the meat is well coated and beginning to cook."
    },
    {
      "step": 6,
      "instruction": "Mix yoghurt with water until smooth, then add to the curry. Stir well. Season with black pepper and salt."
    },
    {
      "step": 7,
      "instruction": "Cover with a lid, bring to a boil, then reduce heat to low. Simmer until the sauce thickens and the lamb is cooked through and tender, about 30–35 minutes."
    },
    {
      "step": 8,
      "instruction": "Remove bay leaves and cinnamon stick before serving. Serve hot with steamed rice or naan bread."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Yoghurt Tip",
      "content": "Mix the yoghurt with water before adding to the pan — this prevents it from splitting when it hits the hot curry. Use room temperature yoghurt for the same reason."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Source",
      "content": "Adapted from traditional Indian korma recipes."
    }
  ],
