  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 170°C. Grease a 28 cm round cake tin and dust with flour, shaking out any excess."
    },
    {
      "step": 2,
      "instruction": "Place all cake ingredients — sifted flour, caster sugar, cinnamon, bi-carb soda, eggs, oil, mashed bananas, pecans, and crushed pineapple with syrup — into the bowl of a stand mixer."
    },
    {
      "step": 3,
      "instruction": "Mix on low speed until just combined. Stop as soon as the dry ingredients disappear. Do not overmix."
    },
    {
      "step": 4,
      "instruction": "Pour batter into the prepared tin and level the top."
    },
    {
      "step": 5,
      "instruction": "Bake for approximately 1 hour 45 minutes, or until a skewer inserted into the centre comes out clean. If the top browns too quickly, cover loosely with foil after the first hour."
    },
    {
      "step": 6,
      "instruction": "Stand cake in the tin for 10 minutes, then turn out onto a wire rack to cool completely."
    },
    {
      "step": 7,
      "instruction": "For the frosting: place cream cheese, sour cream, butter, and vanilla extract into the stand mixer bowl. Beat with the paddle attachment until light and fluffy."
    },
    {
      "step": 8,
      "instruction": "Gradually add sifted icing sugar while mixing on low speed until thick and silky."
    },
    {
      "step": 9,
      "instruction": "Spread frosting thickly over the completely cooled cake."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "One-Bowl Method",
      "content": "All cake ingredients go in together. Mix only until just combined on low speed — overmixing develops gluten and makes the cake tough. A few small streaks of flour are fine."
    },
    {
      "type": "technique",
      "title": "Long Bake",
      "content": "This is a heavy, wet batter that needs time. If the top is browning too fast after the first hour, cover loosely with foil and continue baking until the skewer comes out clean."
    },
    {
      "type": "storage",
      "title": "Storage",
      "content": "Keep refrigerated due to the cream cheese frosting. Bring to room temperature before serving. The cake improves overnight as the flavours meld — it is even better on day two."
    }
  ],
