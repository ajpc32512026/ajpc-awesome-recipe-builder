  ],
  "ingredients": [
    {
      "quantity": "300",
      "unit": "g",
      "item": "Beef",
      "notes": "Scotch Fillet"
    },
    {
      "quantity": "1",
      "unit": "rasher",
      "item": "Middle Bacon",
      "notes": "for wrapping"
    },
    {
      "quantity": "50",
      "unit": "g",
      "item": "Mushrooms",
      "notes": "sliced"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Butter"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Demi Glace"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Cream",
      "notes": "Thickened"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Wrap a rasher of bacon around each scotch fillet and secure with a toothpick or kitchen twine."
    },
    {
      "step": 2,
      "instruction": "Pan-fry or grill over high heat to desired doneness, about 3–4 minutes per side for medium-rare. Remove and rest on a warm plate. Remove the toothpick."
    },
    {
      "step": 3,
      "instruction": "In the same pan, melt butter over medium heat. Add diced onion and cook until softened, about 2–3 minutes. Add mushrooms and cook until golden, about 3–4 minutes."
    },
    {
      "step": 4,
      "instruction": "Pour in demi glace and thickened cream. Stir and reduce for 2–3 minutes until the sauce is rich and glossy. Season with salt."
    },
    {
      "step": 5,
      "instruction": "Plate the bacon-wrapped filet and spoon the mushroom cream sauce generously over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Demi-Forward Sauce",
      "content": "The sauce is demi glace-forward with cream added for richness and body — not a cream-dominant sauce. The demi carries the beefy depth while the cream smooths and enriches."
    }
  ],
