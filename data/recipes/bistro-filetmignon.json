{
  "id": "bistro-filetmignon",
  "title": "Filet Mignon",
  "category": "Bistro",
  "difficulty": "Intermediate",
  "description": "Scotch fillet wrapped in bacon with a mushroom and demi glace cream sauce. Simple, rich, and timeless.",
  "prepTime": "5 min",
  "cookTime": "8 min",
  "totalTime": "13 min",
  "servings": "1 serving",
