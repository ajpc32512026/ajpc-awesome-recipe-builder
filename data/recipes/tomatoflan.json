  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 210°C. Brush a 20 cm deep flan tin with butter or oil and lightly flour the base and sides."
    },
    {
      "step": 2,
      "instruction": "Place 250 g plain flour and 90 g of the cold, cubed unsalted butter in a food processor and process until the mixture resembles fine crumbs."
    },
    {
      "step": 3,
      "instruction": "Add egg yolk and cold water. Process until the dough just comes together."
    },
    {
      "step": 4,
      "instruction": "Turn out onto a lightly floured surface, wrap, and refrigerate for 30 minutes."
    },
    {
      "step": 5,
      "instruction": "Roll pastry to fit the prepared tin. Line with baking paper and fill with dried beans."
    },
    {
      "step": 6,
      "instruction": "Bake for 15 minutes. Remove paper and beans and allow the pastry shell to cool slightly."
    },
    {
      "step": 7,
      "instruction": "Mix olive oil and Dijon mustard to a smooth paste and spread evenly over the pastry base."
    },
    {
      "step": 8,
      "instruction": "Heat the remaining 15 g of unsalted butter in a pan and cook tomatoes and onions until soft. Drain off excess liquid."
    },
    {
      "step": 9,
      "instruction": "Spoon the tomato mixture evenly over the pastry base."
    },
    {
      "step": 10,
      "instruction": "Combine sugar, basil, and olives. Scatter over the tomatoes."
    },
    {
      "step": 11,
      "instruction": "Top with grated Gruyère cheese."
    },
    {
      "step": 12,
      "instruction": "Bake for 20 minutes or until the pastry is crisp and the cheese is golden."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Olives",
      "content": "Use good-quality olives such as Kalamata or Niçoise for best flavour."
    },
