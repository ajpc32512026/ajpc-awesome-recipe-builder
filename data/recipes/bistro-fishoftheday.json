  "ingredients": [
    {
      "quantity": "1",
      "unit": "",
      "item": "Fish Fillet",
      "notes": "fresh, skin-on — varies daily"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Unsalted Butter"
    },
    {
      "quantity": "30",
      "unit": "ml",
      "item": "Lemon Juice",
      "notes": "freshly squeezed"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "White Wine"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Cream",
      "notes": "Thickened"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Fresh Parsley",
      "notes": "fresh, chopped"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Season fish fillets with salt. Melt half the butter in a pan and brush over the fish. Grill under a hot grill for 3–4 minutes per side until just cooked through and the flesh flakes easily."
    },
    {
      "step": 2,
      "instruction": "For the sauce: add remaining butter to a small saucepan over medium heat. Add diced onion and cook until softened, about 2–3 minutes."
    },
    {
      "step": 3,
      "instruction": "Deglaze with white wine and reduce by half, about 1–2 minutes."
    },
    {
      "step": 4,
      "instruction": "Add thickened cream and lemon juice. Stir and reduce for 2–3 minutes until the sauce is light and coats the back of a spoon. Season with salt."
    },
    {
      "step": 5,
      "instruction": "Stir in fresh parsley just before serving. Plate the fish and spoon the lemon cream sauce over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Light Sauce",
      "content": "No demi glace is used — this is a light cream, wine and lemon sauce designed to complement rather than overpower the fish. The fish variety changes with market availability, but the sauce and method remain the same."
    }
  ],
