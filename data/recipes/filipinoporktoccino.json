  "method": [
    {
      "step": 1,
      "instruction": "Slice pork shoulder into pieces approximately 6 mm thick."
    },
    {
      "step": 2,
      "instruction": "In a bowl, combine brown sugar, pineapple juice, soy sauce, vinegar, garlic, salt, and pepper. Stir until sugar dissolves."
    },
    {
      "step": 3,
      "instruction": "Add pork to the marinade and toss to coat evenly. Cover and refrigerate for 24 hours."
    },
    {
      "step": 4,
      "instruction": "Heat vegetable oil in a large pan over medium-low heat."
    },
    {
      "step": 5,
      "instruction": "Cook pork for 10–12 minutes, flipping every minute, until caramelised on both sides. Cook gently to avoid burning the sugar."
    },
    {
      "step": 6,
      "instruction": "Serve with garlic fried rice and fried egg for a traditional Tocilog breakfast, or with steamed rice for dinner."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Marinating Time",
      "content": "Marinate overnight for maximum flavour. Minimum 4 hours if short on time. The sugar and pineapple juice tenderise the meat while infusing it with sweetness."
    },
    {
      "type": "technique",
      "title": "Low and Slow",
      "content": "Cook gently over medium-low heat. The sugar in the marinade will burn if the heat is too high, turning bitter instead of caramelised."
    },
    {
      "type": "variation",
      "title": "Variations",
      "content": "Try chicken tocino for a lighter version. For natural colouring, use annatto powder or beet juice instead of food colouring."
    }
  ],
