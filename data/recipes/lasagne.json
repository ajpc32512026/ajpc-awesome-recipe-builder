  "method": [
    {
      "step": 1,
      "instruction": "Heat olive oil in a large heavy-based pan over medium heat. Sauté onion and garlic for 5–6 minutes until softened."
    },
    {
      "step": 2,
      "instruction": "Add beef mince and brown well, breaking up any lumps with a wooden spoon."
    },
    {
      "step": 3,
      "instruction": "Stir in tomato paste, then add crushed tomatoes, sugar, Italian herbs, 5 g of the salt, and pepper."
    },
    {
      "step": 4,
      "instruction": "Bring to a gentle simmer, then reduce heat to low. Cook for 45–60 minutes, stirring occasionally, until thick and rich."
    },
    {
      "step": 5,
      "instruction": "Meanwhile, make the béchamel: melt butter in a saucepan over medium heat. Whisk in flour and cook for 1–2 minutes until lightly golden."
    },
    {
      "step": 6,
      "instruction": "Slowly whisk in milk, a little at a time, until smooth. Continue stirring for 5–7 minutes until thickened enough to coat the back of a spoon."
    },
    {
      "step": 7,
      "instruction": "Season béchamel with the remaining 2 g of salt and nutmeg. Remove from heat."
    },
    {
      "step": 8,
      "instruction": "Preheat oven to 180°C."
    },
    {
      "step": 9,
      "instruction": "Spread a thin layer of ragù in the base of a 23 cm × 33 cm baking dish."
    },
    {
      "step": 10,
      "instruction": "Layer in this order: lasagne sheets, ragù, béchamel, mozzarella. Repeat for 2–3 layers."
    },
    {
      "step": 11,
      "instruction": "Finish with a final layer of béchamel and sprinkle Parmesan over the top."
    },
    {
      "step": 12,
      "instruction": "Cover with foil and bake for 30 minutes."
    },
    {
      "step": 13,
      "instruction": "Remove foil and bake for a further 15–20 minutes until golden and bubbling."
    },
    {
      "step": 14,
      "instruction": "Rest for 10 minutes before slicing and serving."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Ragù Depth",
      "content": "The longer the ragù simmers, the deeper the flavour. If you have time, cook it for the full 60 minutes — it makes a noticeable difference."
    },
    {
      "type": "technique",
      "title": "Béchamel Consistency",
      "content": "The béchamel should coat the back of a spoon but still be pourable. If it thickens too much while sitting, whisk in a splash of milk before layering."
    },
    {
      "type": "storage",
      "title": "Make Ahead",
      "content": "Assemble the lasagne completely, cover, and refrigerate for up to 24 hours before baking. Add 10 minutes to the covered baking time when cooking from cold."
    }
  ],
