  ],
  "method": [
    {
      "step": 1,
      "instruction": "Place basil, pine nuts, garlic, and Parmesan into a food processor or blender."
    },
    {
      "step": 2,
      "instruction": "Pulse while slowly drizzling in the olive oil until the mixture reaches your desired consistency — smooth or slightly chunky."
    },
    {
      "step": 3,
      "instruction": "Season with salt and pepper to taste. Pulse briefly to combine."
    },
    {
      "step": 4,
      "instruction": "Use immediately or store in the refrigerator with a thin layer of olive oil on top to prevent browning."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Toss with hot pasta, spread on bruschetta, or use as a marinade for chicken or fish. Stir through scrambled eggs or roasted vegetables."
    },
    {
      "type": "storage",
      "title": "Storage",
      "content": "Keep refrigerated for up to 1 week with a thin layer of olive oil covering the surface to prevent oxidation. Freeze in ice cube trays for easy portions."
