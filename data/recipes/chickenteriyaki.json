  "ingredients": [
    {
      "quantity": "340",
      "unit": "g",
      "item": "Chicken Breast",
      "notes": "or thighs, flattened to 2 cm thick"
    },
    {
      "quantity": "15",
      "unit": "ml",
      "item": "Vegetable Oil"
    },
    {
      "quantity": "80",
      "unit": "ml",
      "item": "Soy Sauce"
    },
    {
      "quantity": "80",
      "unit": "ml",
      "item": "Mirin"
    },
    {
      "quantity": "65",
      "unit": "g",
      "item": "White Sugar"
    },
    {
      "quantity": "3",
      "unit": "cloves",
      "item": "Garlic",
      "notes": "crushed"
    },
    {
      "quantity": "5",
      "unit": "g",
      "item": "Fresh Ginger",
      "notes": "grated"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Sesame Seeds",
      "notes": "to garnish"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Flatten chicken to about 2 cm thick for even cooking. Place in a bowl or zipper bag for marinating."
    },
    {
      "step": 2,
      "instruction": "Combine soy sauce, mirin, sugar, garlic, and ginger in a bowl. Stir until sugar dissolves."
    },
    {
      "step": 3,
      "instruction": "Pour half the marinade over the chicken and set aside the remaining half for glazing. Marinate chicken for at least 1 hour in the refrigerator, or up to overnight."
    },
    {
      "step": 4,
      "instruction": "Heat vegetable oil in a large frying pan over medium-high heat."
    },
    {
      "step": 5,
      "instruction": "Remove chicken from marinade and wipe off excess. Cook for 5–6 minutes per side until golden brown and cooked through."
    },
    {
      "step": 6,
      "instruction": "During the last 2–3 minutes, brush the reserved marinade over the chicken. It will reduce into a glossy glaze."
    },
    {
      "step": 7,
      "instruction": "Remove from heat and let rest for 2 minutes. Slice against the grain."
    },
    {
      "step": 8,
      "instruction": "Serve over steamed rice, sprinkle with sesame seeds, and spoon any remaining glaze over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Marinating Time",
      "content": "Minimum 1 hour marinating is recommended. Overnight gives the deepest flavour. The sugar in the marinade helps caramelise the chicken during cooking."
    },
    {
      "type": "variation",
      "title": "Grill or Bake",
      "content": "This also works on a hot grill or baked at 200°C for approximately 20 minutes. Brush reserved marinade during the last 5 minutes to create the glaze."
    }
  ],
