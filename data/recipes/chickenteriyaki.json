{
  "id": "chickenteriyaki",
  "title": "Chicken Teriyaki",
  "category": "Dinner",
  "difficulty": "Beginner",
  "description": "Juicy, tender chicken marinated in a sweet-savoury teriyaki sauce — quick stovetop method for weeknights.",
  "prepTime": "15 min",
  "cookTime": "12 min",
  "totalTime": "1 hr 27 min",
  "servings": "2 servings",
  "yieldPerBatch": "2 servings",
