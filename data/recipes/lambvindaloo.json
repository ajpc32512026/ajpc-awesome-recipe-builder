  "method": [
    {
      "step": 1,
      "instruction": "Prepare 1 batch of [[vindaloopaste|Vindaloo Paste]] according to the vindaloo paste recipe. Set aside."
    },
    {
      "step": 2,
      "instruction": "Place lamb in a large bowl. Add vindaloo paste and toss to coat evenly. Cover and marinate in the refrigerator for at least 1 hour, or overnight for deeper flavour."
    },
    {
      "step": 3,
      "instruction": "Heat vegetable oil in a large heavy-based pot over medium-high heat. Add onions and sauté 2–3 minutes until soft and translucent. Add garlic and sauté 1 minute until fragrant."
    },
    {
      "step": 4,
      "instruction": "Add turmeric, chilli powder, tomato paste, chopped tomatoes, and vinegar. Cook 2–3 minutes until tomatoes break down."
    },
    {
      "step": 5,
      "instruction": "Add marinated lamb and sugar. Season with salt. Cook for 10 minutes, stirring occasionally."
    },
    {
      "step": 6,
      "instruction": "Pour in hot water, bring to a boil, reduce heat to low, cover, and simmer for 1 hour or until lamb is tender and sauce has thickened."
    },
    {
      "step": 7,
      "instruction": "If sauce is too thin, uncover and simmer for a further 5–10 minutes to reduce."
    },
    {
      "step": 8,
      "instruction": "Garnish with fresh coriander and serve with steamed rice."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Overnight Marinade",
      "content": "For the deepest flavour, marinate the lamb overnight in the refrigerator. The vinegar and spices will tenderise the meat while infusing it with flavour."
    },
    {
      "type": "technique",
      "title": "Paste Yield",
      "content": "The vindaloo paste recipe yields approximately 80–100 g — exactly the right amount for 1 kg of lamb. Use the full batch."
    },
    {
      "type": "acknowledgement",
      "title": "Recipe Source",
      "content": "Adapted from traditional Indian vindaloo recipes."
    }
  ],
