  "method": [
    {
      "step": 1,
      "instruction": "Place onion in a food processor with a little water and blend to a smooth paste. Set aside."
    },
    {
      "step": 2,
      "instruction": "Place ginger and garlic in a food processor with a little water and blend to a coarse paste. Set aside."
    },
    {
      "step": 3,
      "instruction": "Heat a small frying pan over low heat. Add fennel seeds and cumin seeds. Roast for 2–3 minutes until aromatic. Allow to cool, then grind to a coarse powder."
    },
    {
      "step": 4,
      "instruction": "Combine the fennel-cumin mix with coriander, turmeric, garam masala, paprika, and red chilli powder in a small bowl. Set aside."
    },
    {
      "step": 5,
      "instruction": "Heat vegetable oil in a large heavy-based pot over medium-high heat. Stir-fry cardamom pods, cloves, and bay leaves for 1–2 minutes until fragrant."
    },
    {
      "step": 6,
      "instruction": "Add onion paste. Cook for 1–2 minutes until the raw smell disappears. Add ginger-garlic paste and cook for 2 minutes until fragrant."
    },
    {
      "step": 7,
      "instruction": "Stir in the spice mix. Cook for 1 minute until aromatic. Add the 60 g of tomato paste. Cook for 1–2 minutes, stirring often."
    },
    {
      "step": 8,
      "instruction": "Add lamb and season with salt. Cook for 10 minutes, stirring occasionally. Stir in yoghurt. Pour in hot water and bring to a boil."
    },
    {
      "step": 9,
      "instruction": "Reduce heat to medium-low. Cover and simmer, stirring occasionally, for 30–40 minutes until lamb is cooked through and tender."
    },
    {
      "step": 10,
      "instruction": "Sprinkle with fresh coriander and serve with naan bread, roti, or steamed rice."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Spice Roasting",
      "content": "Dry roasting the fennel and cumin seeds before grinding releases their essential oils and deepens the flavour. Do not skip this step."
    },
    {
