  "method": [
    {
      "step": 1,
      "instruction": "Brush a rectangular baking tin with olive oil. Combine yeast, warm water, and sugar in a large bowl. Stir to dissolve the yeast, cover, and leave in a warm place for about 10 minutes until frothy."
    },
    {
      "step": 2,
      "instruction": "Add 30 ml of the olive oil. Sift flour, milk powder, and salt into the yeast mixture. Beat with a wooden spoon until well combined, adding a little extra flour if needed to form a soft dough."
    },
    {
      "step": 3,
      "instruction": "Turn the dough onto a lightly floured surface and knead for 10 minutes until smooth and elastic."
    },
    {
      "step": 4,
      "instruction": "Place dough in a large lightly oiled bowl, brush the surface with oil, cover with plastic wrap, and leave in a warm place for 1 hour or until well risen."
    },
    {
      "step": 5,
      "instruction": "Punch down the dough and knead briefly. Roll out to fit the prepared tin. Cover and leave to rise for a further 20 minutes."
    },
    {
      "step": 6,
      "instruction": "Preheat oven to 180°C."
    },
    {
      "step": 7,
      "instruction": "Using the handle of a wooden spoon, press indentations into the dough at regular intervals."
    },
    {
      "step": 8,
      "instruction": "Combine the remaining 15 ml of olive oil and crushed garlic. Brush over the surface. Top with olives and rosemary, then sprinkle with oregano and sea salt flakes."
    },
    {
      "step": 9,
      "instruction": "Cover and leave to rise for a further 30 minutes until well risen."
    },
    {
      "step": 10,
      "instruction": "Bake for 20–25 minutes until golden and crisp. Cut into large squares and serve warm."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Kneading",
      "content": "Proper kneading develops the gluten structure that gives this focaccia its characteristic chewy texture. The dough should be smooth and elastic — if it tears easily, keep kneading."
    },
