      "quantity": "3",
      "unit": "",
      "item": "Banana",
      "notes": "mashed"
    },
    {
      "quantity": "80",
      "unit": "g",
      "item": "Unsalted Butter"
    },
    {
      "quantity": "150",
      "unit": "g",
      "item": "Brown Sugar"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Eggs"
    },
    {
      "quantity": "5",
      "unit": "ml",
      "item": "Natural Vanilla Extract"
    },
    {
      "quantity": "5",
      "unit": "g",
      "item": "Bi-carb Soda"
    },
    {
      "quantity": "1",
      "unit": "g",
      "item": "Salt"
    },
    {
      "quantity": "190",
      "unit": "g",
      "item": "Plain Flour",
      "notes": "sifted"
    },
    {
      "quantity": "60",
      "unit": "g",
      "item": "Walnuts",
      "notes": "chopped"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 175°C. Grease and line a loaf tin."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, mix mashed bananas, melted butter, brown sugar, egg, and vanilla extract until well combined."
    },
    {
      "step": 3,
      "instruction": "Sprinkle over bi-carb soda and salt, then gently fold in plain flour until just combined."
    },
    {
      "step": 4,
      "instruction": "Fold through walnuts, taking care not to overmix."
    },
    {
      "step": 5,
      "instruction": "Pour batter into prepared 23 cm loaf tin and smooth the top."
    },
    {
      "step": 6,
      "instruction": "Bake for 50–60 minutes, or until a skewer inserted into the centre comes out clean."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Slice thick, toast lightly, and spread with butter while still warm."
    },
    {
      "type": "variation",
      "title": "Variations",
      "content": "Walnuts can be replaced with dark chocolate chips or omitted entirely for a plain loaf."
    },
    {
      "type": "technique",
      "title": "Portioning Guide",
      "content": "Cuts cleanly into 9 slices at approximately 25 mm thick. For thinner slices, slice at 20 mm for up to 12 serves."
    }
  ],
