  "ingredients": [
    {
      "quantity": "1",
      "unit": "",
      "item": "Chicken Breast",
      "notes": "pan-fried"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "Fresh Ginger",
      "notes": "finely grated"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Fresh Red Chilli",
      "notes": "fresh, finely sliced"
    },
    {
      "quantity": "60",
      "unit": "ml",
      "item": "Cream",
      "notes": "Thickened"
    },
    {
      "quantity": "30",
      "unit": "g",
      "item": "Unsalted Butter"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Brown Onion",
      "notes": "diced"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Melt half the butter in a frying pan over medium-high heat. Pan-fry chicken breast for 3–4 minutes per side until golden and cooked through. Remove and rest on a warm plate."
    },
    {
      "step": 2,
      "instruction": "In the same pan, add remaining butter. Add diced onion and grated ginger and cook until softened and fragrant, about 2–3 minutes."
    },
    {
      "step": 3,
      "instruction": "Add fresh chilli and cook briefly for 30 seconds until aromatic."
    },
    {
      "step": 4,
      "instruction": "Pour in thickened cream and reduce for 2–3 minutes until the sauce coats the back of a spoon. Season with salt."
    },
    {
      "step": 5,
      "instruction": "Plate the chicken and spoon the ginger-chilli cream sauce generously over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Fresh Chilli and Ginger",
      "content": "This dish uses fresh red chilli and fresh grated ginger — not dried, paste, or sambal. The heat is mild and aromatic rather than fiery, letting the cream carry the warmth. No demi glace is used."
    }
  ],
