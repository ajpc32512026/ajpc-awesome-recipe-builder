      "unit": "",
      "item": "Brown Onion"
    },
    {
      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Heat olive oil in a pan over medium heat."
    },
    {
      "step": 2,
      "instruction": "Sauté onion until soft and translucent, about 5 minutes."
    },
    {
      "step": 3,
      "instruction": "Add garlic and red chilli, cook for 1 minute until fragrant."
    },
    {
      "step": 4,
      "instruction": "Add peeled tomatoes, crushing them by hand or with a spoon as they go in."
    },
    {
      "step": 5,
      "instruction": "Simmer on low heat for 15–20 minutes, stirring occasionally, until thickened."
    },
    {
      "step": 6,
      "instruction": "Season with salt and black pepper to taste."
    },
    {
      "step": 7,
      "instruction": "Serve hot with your favourite pasta."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Perfect with penne pasta. Adjust chilli flakes to control the heat level. Pairs beautifully with a glass of red wine."
    }
