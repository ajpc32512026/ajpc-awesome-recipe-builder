      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Grill or pan-fry scotch fillets over high heat to desired doneness. Remove and rest on a warm plate."
    },
    {
      "step": 2,
      "instruction": "Melt butter in a saucepan over medium heat. Add flour and whisk for 1–2 minutes to cook the roux until pale golden."
    },
    {
      "step": 3,
      "instruction": "Gradually add warmed milk, whisking constantly until smooth and thickened, about 3–4 minutes."
    },
    {
      "step": 4,
      "instruction": "Remove from heat. Add grated cheese and stir until melted and smooth. Season with salt, white pepper, and nutmeg."
    },
    {
      "step": 5,
      "instruction": "Gently fold seafood into the Mornay sauce and warm through on low heat — do not boil or the seafood will toughen."
    },
    {
      "step": 6,
      "instruction": "Plate the steak and spoon the seafood Mornay generously over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Mornay Base",
      "content": "No demi glace is used — this is a pure béchamel-cheese sauce. The same Mornay base is used for oysters Mornay and Veal Oscar. Keep the heat gentle once the seafood is added to prevent toughening."
    }
  ],
