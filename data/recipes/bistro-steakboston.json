  "method": [
    {
      "step": 1,
      "instruction": "Mix paprika, chilli powder, garlic powder, onion powder, oregano, and thyme into a Creole spice blend."
    },
    {
      "step": 2,
      "instruction": "Coat both sides of the scotch fillets generously with the spice blend, pressing it on firmly."
    },
    {
      "step": 3,
      "instruction": "Heat a heavy-based pan or grill over high heat. Cook fillets for 2–3 minutes per side for medium-rare, or to desired doneness. Remove and rest on a warm plate."
    },
    {
      "step": 4,
      "instruction": "For the sauce: melt half the butter in the same pan over medium heat. Add diced onion and cook until softened, about 2–3 minutes."
    },
    {
      "step": 5,
      "instruction": "Deglaze with red wine, scraping up any spice residue and browned bits from the steak. Let it reduce by half, about 1–2 minutes."
    },
    {
      "step": 6,
      "instruction": "Remove from heat and swirl in the remaining butter until melted and glossy. Season with salt."
    },
    {
      "step": 7,
      "instruction": "Plate the steak and spoon the red wine butter sauce over the top."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Creole Spice",
      "content": "The Creole spice blend is the signature of this dish — a dry coating that forms a flavourful, slightly blackened crust when seared. No demi glace is used. The sauce is a simple red wine and butter reduction that deglazes the pan and captures the spice residue from the steak."
    }
  ],
