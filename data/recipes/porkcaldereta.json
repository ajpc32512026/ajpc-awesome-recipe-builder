  "method": [
    {
      "step": 1,
      "instruction": "Heat oil in a large pot over medium heat. Sauté garlic and onion until fragrant and the onion is translucent."
    },
    {
      "step": 2,
      "instruction": "Add pork cubes. Cook for 5–7 minutes, stirring occasionally, until the meat is lightly browned on all sides."
    },
    {
      "step": 3,
      "instruction": "Pour in tomato sauce and pork stock. Add the stock cube. Bring to a boil, then lower the heat and cover. Simmer for 45–60 minutes, or until the pork is fork-tender."
    },
    {
      "step": 4,
      "instruction": "Stir in liver spread until fully incorporated. If using chilli peppers, add them now."
    },
    {
      "step": 5,
      "instruction": "Add potatoes and carrots. Cover and cook for about 8–10 minutes until tender."
    },
    {
      "step": 6,
      "instruction": "Stir in capsicum and olives. Cook for another 3–5 minutes. Season with salt and pepper to taste."
    },
    {
      "step": 7,
      "instruction": "Transfer to a serving dish. If desired, top with shredded cheese while hot so it melts into the sauce."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Crispy Vegetables",
      "content": "To prevent the potatoes and carrots from going mushy, pan-fry them separately before adding to the stew at the end."
    },
    {
      "type": "variation",
      "title": "Creamier Version",
      "content": "Adding a tablespoon of peanut butter or a splash of coconut milk creates a richer, more modern take on this dish."
    },
    {
      "type": "technique",
      "title": "Meat Choice",
      "content": "Pork shoulder gives the best balance of tenderness and fat. Ribs add extra flavour but take longer to become fork-tender."
    },
    {
      "type": "storage",
      "title": "Leftovers",
      "content": "Caldereta keeps well refrigerated for up to 3 days and the flavour deepens overnight. Reheat gently on the stovetop."
    }
  ],
