  "method": [
    {
      "step": 1,
      "instruction": "In a small saucepan, combine tomato sauce, brown sugar, white vinegar, pineapple juice, and soy sauce."
    },
    {
      "step": 2,
      "instruction": "Place over medium heat and stir until the sugar dissolves completely."
    },
    {
      "step": 3,
      "instruction": "Bring to a gentle simmer and cook for 5–7 minutes, stirring occasionally."
    },
    {
      "step": 4,
      "instruction": "If a thicker sauce is desired, mix cornflour with 1 tablespoon of cold water to form a smooth slurry. Add to the simmering sauce."
    },
    {
      "step": 5,
      "instruction": "Cook for another 2–3 minutes, stirring constantly, until the sauce thickens to your desired consistency."
    },
    {
      "step": 6,
      "instruction": "Add vegetables. Cook until slightly tender."
    },
    {
      "step": 7,
      "instruction": "Remove from heat and use immediately, or let cool and store in an airtight container in the refrigerator for up to 1 week."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Balance the Flavours",
      "content": "Taste and adjust: add more vinegar for tang, more sugar for sweetness, or a splash of soy sauce for depth."
    },
    {
      "type": "variation",
      "title": "Add Heat",
      "content": "Stir in 2–5 g of chilli flakes or a dash of sriracha for a spicy kick."
    },
    {
      "type": "serving",
      "title": "Uses",
      "content": "Perfect for sweet and sour pork, chicken stir-fries, spring rolls, or as a dipping sauce for fried appetisers."
    }
  ],
