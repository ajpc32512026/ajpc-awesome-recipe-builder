      "item": "Salt & Pepper",
      "toTaste": true,
      "notes": "Don't add too much all at once — you can't take it out once it's in."
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Dust each lamb cutlet lightly with flour, dip in beaten egg, and coat thoroughly with breadcrumbs. Press crumbs on firmly."
    },
    {
      "step": 2,
      "instruction": "Melt half the butter in a frying pan over medium heat. Pan-fry crumbed cutlets for 2–3 minutes per side until golden and cooked through. Remove and rest on a warm plate."
    },
    {
      "step": 3,
      "instruction": "In a separate pan, fry bacon until crisp. Set aside on paper towels."
    },
    {
      "step": 4,
      "instruction": "For the gravy: add remaining butter to the cutlet pan. Add diced onion and cook until softened, about 2–3 minutes."
    },
    {
      "step": 5,
      "instruction": "Pour in demi glace and reduce for 2–3 minutes until the gravy is rich and glossy. Season with salt."
    },
    {
      "step": 6,
      "instruction": "Plate the cutlets, lay crispy bacon over the top, and pour the demi glace gravy alongside or generously over."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Demi Glace Gravy",
      "content": "The gravy is a simple demi glace reduction — no additional wine, herbs, or mushroom. The richness of the demi carries the dish, balanced by the crisp bacon and crumbed lamb."
    }
  ],
