  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Grease a deep 28 cm round cake tin and line the base with baking paper."
    },
    {
      "step": 2,
      "instruction": "Combine poppy seeds and milk in a bowl. Let stand for 20 minutes to soften and bloom."
    },
    {
      "step": 3,
      "instruction": "Cream softened unsalted butter, 25 g of the orange zest, and caster sugar with an electric mixer until light and fluffy."
    },
    {
      "step": 4,
      "instruction": "Add eggs one at a time, beating well after each addition."
    },
    {
      "step": 5,
      "instruction": "Transfer mixture to a large bowl. Stir in sifted flours, 60 g almond meal, poppy seed mixture, and 80 ml of the orange juice. Mix until just combined."
    },
    {
      "step": 6,
      "instruction": "Spread into the prepared tin and bake for approximately 45 minutes or until a skewer inserted into the centre comes out clean."
    },
    {
      "step": 7,
      "instruction": "Cool on a wire rack. Once cold, slice horizontally into three layers."
    },
    {
      "step": 8,
      "instruction": "For the frosting: beat softened cream cheese, sour cream, and the remaining 15 g of orange zest in a medium bowl with an electric mixer until smooth."
    },
    {
      "step": 9,
      "instruction": "Add sifted icing sugar and the remaining 15 ml of orange juice. Beat until thick, glossy, and silky."
    },
    {
      "step": 10,
      "instruction": "Sandwich cake layers together with half the orange cream, then cover the top and sides with the remaining cream."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Poppy Seed Blooming",
      "content": "Soaking the poppy seeds in milk for 20 minutes softens them and releases their nutty flavour into the cake. Do not skip this step."
    },
    {
      "type": "technique",
      "title": "Layer Cake Assembly",
      "content": "Use a long serrated knife to slice the cooled cake evenly into three layers. If the cake is slightly warm, chill it for 30 minutes first — cold cake cuts more cleanly."
    },
    {
      "type": "storage",
      "title": "Storage",
      "content": "Keep refrigerated due to the cream cheese frosting. Bring to room temperature before serving."
    }
  ],
